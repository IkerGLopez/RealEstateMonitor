TURSO_URL=libsql://your-turso-db-name.turso.io
TURSO_AUTH_TOKEN=your-optional-turso-token

# Milestone 4 - Telegram Notifications
ENABLE_NOTIFICATIONS=true
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Milestone 5 - Scheduling
# Default cron expression for the automated scheduler
SCRAPE_CRON="*/30 * * * *"

# Milestone 6 - Dashboard
DASHBOARD_PORT=3000
